# Environment
NODE_ENV=development
PORT=3001

# Database - Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# CORS
FRONTEND_URL="http://localhost:5173"

# Cloudinary (server-side only; never expose this value in the frontend)
CLOUDINARY_URL="cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME"


# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# One-off data repairs (avatar backfill, roster rename). Keep disabled in production.
RUN_STARTUP_DATA_SYNC=false

# Seed / bootstrap passwords (never commit real values)
SEED_ADMIN_PASSWORD=""
SEED_MOD_PASSWORD=""
SEED_USER_PASSWORD=""
ADMIN_PASSWORD=""
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@example.com"
